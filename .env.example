# ===============================================
# SnagWalk Environment Configuration
# ===============================================

# AlloyDB (PostgreSQL) Connection Settings
# Read DB host, user and password from environment variables, never hardcode them.
DB_HOST=10.x.x.x
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-alloydb-password
DB_NAME=postgres
DB_SSL=false

# Google Cloud & Vertex AI Settings
# Project: snagwalk-515212
GOOGLE_CLOUD_PROJECT=snagwalk-515212
VERTEX_AI_LOCATION=us-central1
GCS_BUCKET_NAME=snagwalk-photos-515212

# Optional Gemini API Key fallback (for local development outside GCP Vertex ADC)
GEMINI_API_KEY=
