# ===============================================
# SnagWalk environment configuration
# ===============================================

# AlloyDB (PostgreSQL). Read from the environment, never hardcode.
DB_HOST=10.x.x.x
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-alloydb-password
DB_NAME=postgres
DB_SSL=false
# Local JSON fallback when AlloyDB is unreachable (outside the VPC). Default: on in dev, off in production.
# DB_FALLBACK=on

# Google Cloud
GOOGLE_CLOUD_PROJECT=snagwalk-515212
GCS_BUCKET_NAME=snagwalk-photos-515212
# Local disk fallback when the bucket is unreachable. Default: on in dev, off in production.
# STORAGE_FALLBACK=on

# Gemini on Vertex AI
# adc    = Application Default Credentials (Cloud Run service account, or `gcloud auth application-default login`)
# apikey = GEMINI_API_KEY ("AQ." Vertex express key, or an AI Studio key)
# auto   = apikey if GEMINI_API_KEY is set, else adc
GEMINI_AUTH=adc
GEMINI_MODEL=gemini-3.5-flash
# gemini-3.5-flash is served from asia-south1 (Mumbai) and global, not us-central1.
VERTEX_AI_LOCATION=asia-south1
# Thinking level for Gemini 3.x (low keeps photo analysis to a few seconds). "off" to omit.
GEMINI_THINKING=low
GEMINI_API_KEY=
